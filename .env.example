# Copy this file to .env.local and fill in real values.
# Public Supabase project URL and publishable (anon-safe) key — used by the
# browser client in src/lib/supabase.ts. Never put the secret/service_role
# key in a NEXT_PUBLIC_ variable or anywhere in frontend code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
