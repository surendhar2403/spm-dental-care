# Copy this file to .env.local and fill in real values.
# Public Supabase project URL and publishable (anon-safe) key — used by the
# browser client in src/lib/supabase.ts. Never put the secret/service_role
# key in a NEXT_PUBLIC_ variable or anywhere in frontend code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only signing secret for the Revenue authorization session cookie.
# The Revenue password itself is stored as a Supabase hash, never here.
REVENUE_ACCESS_SESSION_SECRET=
